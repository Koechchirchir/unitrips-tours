PORT=3000
# Environment: 'production' for live payments or 'sandbox' for testing
MPESA_ENV=sandbox

# Daraja API credentials
MPESA_CONSUMER_KEY=replace_with_daraja_consumer_key
MPESA_CONSUMER_SECRET=replace_with_daraja_consumer_secret
MPESA_PASSKEY=replace_with_daraja_passkey

# For Till (Buy Goods):
# MPESA_SHORTCODE is the Store / Head Office shortcode provided in the Daraja portal.
# MPESA_TILL_NUMBER is your actual Buy Goods Till Number that clients pay to.
MPESA_SHORTCODE=replace_with_store_or_head_office_number
MPESA_TILL_NUMBER=replace_with_your_till_number

# Transaction Type: CustomerBuyGoodsOnline for Till, CustomerPayBillOnline for Paybill
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# Public HTTPS URL ending in /api/mpesa/callback
MPESA_CALLBACK_URL=https://replace-with-your-public-callback-url.example.com/api/mpesa/callback
